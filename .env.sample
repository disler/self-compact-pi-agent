# Copy to .env at the repo root. `just` loads it automatically (set dotenv-load).
# Pi reads provider keys from the environment; pick any provider Pi supports.

# Recommended: OpenRouter. One key, every model, pay per token.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional alternatives (only needed if you launch with that provider's models).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
